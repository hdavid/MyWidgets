# Build identity. Copy to local-config/build.env (gitignored) and set your own.
# These are not secrets — every signed macOS app exposes its team id and bundle
# id — they are simply yours rather than the project's, so they live outside the
# repo. scripts/configure.sh reads this file as the fallback, so a fresh clone
# builds (ad-hoc signed) without any setup.

# Reverse-DNS prefix for the bundle identifiers.
BUNDLE_PREFIX=com.example

# Product name. Also used for the bundle id and App Group.
APP_NAME=MyWidgets

# 10-character Apple Developer Team ID. "-" builds ad-hoc signed, which is fine
# for local testing but not distributable.
DEVELOPMENT_TEAM=-
