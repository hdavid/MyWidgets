# Copy to .env.local (gitignored) and fill in. Used by scripts/setup-github-secrets.sh
# to push the release workflow's secrets, and readable by scripts/build-release.sh
# for a signed local build:  set -a; . ./.env.local; set +a; ./scripts/build-release.sh

# Exactly as it appears in: security find-identity -v -p codesigning
DEVELOPER_ID_APP=Developer ID Application: Your Company Oy (ABCDE12345)

# Notarization — an app-specific password, NOT your Apple ID password.
# Create one at appleid.apple.com → Sign-In and Security → App-Specific Passwords.
NOTARY_APPLE_ID=you@example.com
NOTARY_TEAM_ID=ABCDE12345
NOTARY_PASSWORD=xxxx-xxxx-xxxx-xxxx
