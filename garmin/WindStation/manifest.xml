<?xml version="1.0" encoding="UTF-8"?>
<!-- Wind widget for Henri's Vevor station Grafana (moutiers.motscousus.com).
     Product list is a broad guess at modern CIQ 3.1+ watches; prune to the
     actual target device once known — unknown ids fail the build harmlessly. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application id="15de964b0f6c41fc9949fc0e4bf992f5" type="widget"
                    name="@Strings.AppName" entry="WindStationApp"
                    launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.1.0">
        <iq:products>
            <!-- bro -->
            <iq:product id="fenix7x"/>
            <!-- dad -->
            <iq:product id="venu2plus"/>
            <!-- compile/simulator test target (device files always present) -->
            <iq:product id="fenix847mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="ComplicationPublisher"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
