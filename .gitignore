# Generated by xcodegen from project.yml — never commit it
*.xcodeproj

# Build output. The glob matters: device builds use per-destination derived
# data (.build-ios, .build-ipad), and a bare `.build/` let 140 MB of .build-ipad
# into be495c3 before anyone noticed.
.build*/
build/
dist/
DerivedData/

# Secrets: signing identity + notarization credentials
.env.local
*.p12
*.cer
*.mobileprovision

# This machine's real widget config — endpoints and Grafana tokens.
# The committed defaults are generic on purpose; see scripts/local-config.sh.
local-config/

# macOS / editor cruft
.DS_Store
.idea/
xcuserdata/
*.xcuserstate

# Generated by scripts/configure.sh from your build identity
Shared/BuildConfig.generated.swift
entitlements/
*.entitlements


# Generated by xcodegen from project.yml
App/Info.plist

# Config copied into the bundle at build time when there is no App Group
BundledConfig/
